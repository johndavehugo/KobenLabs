APP_NAME=KobenLabs
APP_ENV=local
# Per-machine secret. Filled by `composer run setup` (php artisan key:generate). Never commit a real key.
APP_KEY=
APP_DEBUG=true
# Served by Laravel Herd from the parked directory on your own PC: KobenLabs -> http://kobenlabs.test
# For LAN sharing use http://<this-PC-IP>:8000 instead. See docs/installation.md "Sharing with the lab".
APP_URL=http://kobenlabs.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Lets the dev server answer several Lab Client uploads at once when sharing.
PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=koben_lab
DB_USERNAME=koben
# The password you chose in installation.md step 2 (CREATE USER ... IDENTIFIED BY '...').
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Reverb (live updates: typing, rosters, screens, PC status).
# APP_ID/KEY/SECRET are per-machine secrets: leave blank, `composer run setup`
# generates them. Do NOT use `php artisan reverb:install` to fill blanks - it only
# adds missing lines and skips keys that already exist.
# HOST/PORT/SCHEME below are working single-PC defaults; set HOST to this PC's LAN
# IP when sharing. See docs/installation.md "Sharing with the lab".
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# First admin account for `php artisan db:seed`. Omit all four to get the default
# admin@example.com / password (change it immediately).
# SEED_ADMIN_EMAIL=you@school.edu
# SEED_ADMIN_PASSWORD=something-long
# SEED_ADMIN_FIRST_NAME=Your
# SEED_ADMIN_LAST_NAME=Name

# Live Screens. The Lab Client on each lab PC reports its screen to the staff
# Live Screens page. See docs/reference.md section 8b.
#
# Changing any of these retunes every enrolled machine: the server hands the
# effective values back to each client on request.
LAB_MONITORING_ENABLED=true
LAB_MONITORING_INTERVAL=0.25

# Common tuning knobs (defaults shown; uncomment to override). Full list in config/lab.php.
# LAB_MONITORING_WIDTH=1280
# LAB_MONITORING_QUALITY=60
# LAB_MONITORING_FRAME_MAX_KB=512
# LAB_MONITORING_CLIENT_SILENT=30
# LAB_MONITORING_FRAME_STALE=15
# LAB_PC_STALE_MINUTES=10
# LAB_UPLOAD_MAX_KB=51200
# LAB_GROUP_UPLOAD_MAX_KB=10240
# LAB_STUDENT_QUOTA_MB=500
# LAB_TEACHER_QUOTA_MB=2000
# LAB_ADMIN_QUOTA_MB=5000
# LAB_GROUP_MESSAGE_MAX=2000
# LAB_GROUP_TYPING_TTL=6
