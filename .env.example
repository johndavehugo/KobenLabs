# Reverb (live updates: typing, rosters, screens, PC status).
# APP_ID/KEY/SECRET are per-machine secrets: leave blank, `composer run setup`
# generates them. Do NOT use `php artisan reverb:install` to fill blanks — it only
# adds missing lines and skips keys that already exist.
# HOST/PORT/SCHEME below are working single-PC defaults; set HOST to this PC's LAN
# IP when sharing. See docs/installation.md "Sharing with the lab".
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# First admin account for `php artisan db:seed`. Omit all four to get the default
# admin@example.com / password (change it immediately).
# SEED_ADMIN_EMAIL=you@school.edu
# SEED_ADMIN_PASSWORD=something-long
# SEED_ADMIN_FIRST_NAME=Your
# SEED_ADMIN_LAST_NAME=Name

# Live Screens. The Lab Client on each lab PC reports its screen to the staff
# Live Screens page. See docs/reference.md section 8b.
#
# Changing any of these retunes every enrolled machine: the server hands the
# effective values back to each client on request.
LAB_MONITORING_ENABLED=true
LAB_MONITORING_INTERVAL=0.25

# Common tuning knobs (defaults shown; uncomment to override). Full list in config/lab.php.
