APP_NAME=KobenLabs
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Served by Laravel Herd from the parked directory, not `artisan serve`.
# Herd derives the host from the folder name: KobenLabs -> kobenlabs.test
APP_URL=http://kobenlabs.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=koben_lab
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# --- Computer lab (config/lab.php) ---------------------------------------
# Session lifetime in minutes. The legacy app used a 10 minute sliding
# window while its documentation claimed 10, 30, 30 and 60 minutes in four
# different places.
LAB_SESSION_LIFETIME=120

# Minutes before an idle PC is marked offline. Maintenance PCs are exempt.
LAB_PC_STALE_MINUTES=10

# Per-role file quotas, in megabytes.
LAB_STUDENT_QUOTA_MB=500
LAB_TEACHER_QUOTA_MB=2000
LAB_ADMIN_QUOTA_MB=5000

# Upload ceilings, in kilobytes.
LAB_UPLOAD_MAX_KB=51200
LAB_GROUP_UPLOAD_MAX_KB=10240

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
