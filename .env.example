APP_NAME=KobenLabs
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Served by Laravel Herd from the parked directory, not `artisan serve`.
# Herd derives the host from the folder name: KobenLabs -> kobenlabs.test
APP_URL=http://kobenlabs.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=koben_lab
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
VITE_REVERB_APP_KEY=""
VITE_REVERB_HOST=""
VITE_REVERB_PORT=""
VITE_REVERB_SCHEME=""
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# --- Computer lab (config/lab.php) ---------------------------------------
# Session lifetime in minutes. The legacy app used a 10 minute sliding
# window while its documentation claimed 10, 30, 30 and 60 minutes in four
# different places.
LAB_SESSION_LIFETIME=120

# Minutes before an idle PC is marked offline. Maintenance PCs are exempt.
LAB_PC_STALE_MINUTES=10

# --- Live Screens -----------------------------------------------------------
#
# The Lab Client is the background process on each lab PC that reports its screen
# to the staff Live Screens page. Enrol a machine with:
#
#     php artisan pcs:enrol-client "LAB-01"
#
# which prints a token once. Then run install-service.ps1 on the PC.
#
# Master switch. Set false and every enrolled client refuses to upload, which
# turns the feature off without uninstalling it from each machine.
LAB_MONITORING_ENABLED=true

# Seconds between frames. The server hands this back to every client in an
# X-Frame-Interval response header, so this is the one place the rate is decided.
# 1 second is what a grid needs; drop to 2 on a slower network.
LAB_MONITORING_INTERVAL=1.0

# Capture width in pixels; height follows the aspect ratio. 1280 matches what the
# legacy client was tuned to. 640 roughly halves bandwidth again.
LAB_MONITORING_WIDTH=1280

# JPEG quality. 60 was legacy's tuned value for legible text.
LAB_MONITORING_QUALITY=60

# Body-size ceiling for a frame, in kilobytes. Roughly 5x a 1280px q60 frame.
LAB_MONITORING_FRAME_MAX_KB=512

# A client that has not checked in for this long is reported as silent. Separate
# from LAB_PC_STALE_MINUTES, which answers "is anyone using this machine" —
# a client on an idle PC is working correctly.
LAB_MONITORING_CLIENT_SILENT=30

# A stored frame older than this is not shown, so a stopped client reads as
# offline rather than as a frozen image that looks live.
LAB_MONITORING_FRAME_STALE=15

# Record who viewed which PC, and when. Metadata only — no frame bytes are kept.
LAB_MONITORING_AUDIT=true

# Per-role file quotas, in megabytes.
LAB_STUDENT_QUOTA_MB=500
LAB_TEACHER_QUOTA_MB=2000
LAB_ADMIN_QUOTA_MB=5000

# Upload ceilings, in kilobytes.
LAB_UPLOAD_MAX_KB=51200
LAB_GROUP_UPLOAD_MAX_KB=10240

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
